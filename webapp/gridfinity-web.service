[Unit]
Description=Gridfinity Drawer Baseplate Web Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/gridfinity-web/webapp
Environment=QT_QPA_PLATFORM=offscreen
Environment=OPENSCAD_BIN=/usr/local/bin/openscad-nightly
ExecStart=/root/venv/bin/gunicorn --workers 1 --threads 2 --timeout 600 --bind 0.0.0.0:55504 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
